.grade-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.grade-item:last-child {
  border-bottom: none;
}

.grade-left {
  flex: 1;
  margin-right: 24rpx;
}

.grade-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.grade-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.grade-type {
  font-size: 24rpx;
  color: #999;
}

.grade-rank {
  font-size: 22rpx;
  color: #666;
  padding-left: 12rpx;
  border-left: 1rpx solid #e8e8e8;
}

.grade-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx;
}

.grade-score {
  font-size: 36rpx;
  font-weight: 700;
}

.score-detail-hint {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #999;
}

.score-green {
  color: #52c41a;
}

.score-blue {
  color: #1890ff;
}

.score-orange {
  color: #fa8c16;
}

.score-red {
  color: #ff4d4f;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.45);
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 20rpx;
  background: #fff;
}

.modal-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.grade-detail-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
  color: #666;
  font-size: 24rpx;
}

.detail-total-score {
  font-size: 36rpx;
  font-weight: 700;
}

.detail-loading,
.detail-error,
.detail-empty {
  padding: 36rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

.detail-error {
  color: #ff4d4f;
}

.component-header,
.component-row {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(70rpx, 0.7fr));
  align-items: center;
  column-gap: 12rpx;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
  font-size: 22rpx;
  color: #555;
}

.component-header {
  min-height: 64rpx;
  background: #fafafa;
  color: #333;
  font-weight: 600;
}

.component-name {
  padding-left: 12rpx;
  text-align: left;
  word-break: break-all;
}

.modal-close {
  margin-top: 28rpx;
  padding: 20rpx;
  text-align: center;
  color: #1890ff;
  font-size: 28rpx;
  font-weight: 600;
}
