.not-logged {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 32rpx;
}

.not-logged-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #f4f8ff 0%, #edf4ff 100%);
}

.not-logged-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.not-logged-text {
  font-size: 30rpx;
  color: #666;
}

.login-card {
  padding-top: 12rpx;
}

/* Section tabs */
.section-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.sec-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 14rpx;
}

.sec-tab.active {
  background: #1890ff;
  color: #fff;
  font-weight: 600;
}

.refresh-btn {
  font-size: 26rpx;
  color: #1890ff;
}

/* Devices */
.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-item:last-child {
  border-bottom: none;
}

.device-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.device-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.device-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f4f8ff 0%, #edf4ff 100%);
}

.device-icon-image {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.device-detail {
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.online-dot {
  color: #52c41a;
  font-size: 20rpx;
  margin-left: 8rpx;
}

.device-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.unbind-btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
}

/* Payments */
.payment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.payment-item:last-child {
  border-bottom: none;
}

.payment-left {
  display: flex;
  flex-direction: column;
}

.payment-time {
  font-size: 26rpx;
  color: #333;
}

.payment-remark {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.payment-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #52c41a;
}

.modal-desc {
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.form-item {
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.captcha-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.captcha-input {
  flex: 1;
}

.captcha-refresh-btn {
  width: 144rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d9d9d9;
  background: #fff;
  color: #333;
  font-size: 26rpx;
  padding: 0;
}

.captcha-refresh-btn::after {
  border: none;
}

.captcha-panel {
  width: 240rpx;
  height: 88rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  border: 1rpx dashed #d9d9d9;
  background: #fafafa;
  overflow: hidden;
}

.captcha-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #fff;
}

.captcha-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.captcha-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}
