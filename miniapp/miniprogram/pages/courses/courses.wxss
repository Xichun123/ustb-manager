/* Announcements */
.announcements {
  overflow: hidden;
}

.announcement-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.announcement-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.announcement-badge {
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  text-align: center;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
}

.announcement-arrow {
  font-size: 24rpx;
  color: #8c8c8c;
}

.announcement-list {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}

.announcement-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.announcement-item:last-child {
  border-bottom: none;
}

.announcement-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #666;
}

/* Tabs */
.view-tabs {
  display: flex;
  padding: 6rpx;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.view-tab.active {
  background: #4a8cff;
  color: #fff;
  font-weight: 600;
}

/* Filters */
.filters-card {
  padding-bottom: 28rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.picker-item {
  min-width: 0;
}

.picker-btn {
  min-height: 92rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #f7faff;
  box-sizing: border-box;
  border: 1rpx solid #e7eefc;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.picker-wide {
  grid-column: span 2;
}

.picker-label {
  font-size: 22rpx;
  color: #98a2b3;
}

.picker-value {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #2d3a52;
  font-weight: 500;
}

.search-box {
  margin-top: 18rpx;
}

.search-input {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #e7eefc;
  background: #fff;
  font-size: 26rpx;
}

/* Stats */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-value {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 700;
  color: #4a8cff;
}

.stat-label {
  font-size: 24rpx;
  color: #98a2b3;
}

/* Course list */
.course-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.course-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.course-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.course-title {
  flex: 1;
  min-width: 0;
}

.course-name {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
  color: #1f2937;
  font-weight: 600;
}

.course-code {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa4b2;
}

.tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.tag-red {
  color: #c2410c;
  background: #fff2e8;
}

.tag-blue {
  color: #2563eb;
  background: #eef4ff;
}

.course-meta-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.course-meta-row.secondary {
  align-items: flex-start;
}

.course-info {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.6;
  color: #5b6472;
}

.course-subinfo {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8a94a6;
}

.capacity-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #3b82f6;
  background: #eef4ff;
}

.course-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  min-width: 144rpx;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.action-btn-primary {
  background: #4a8cff;
  color: #fff;
}

.action-btn-danger {
  background: #fff1f0;
  color: #d4380d;
}

.action-btn-muted {
  background: #f7faff;
  color: #4a8cff;
}

.action-btn-disabled {
  background: #eef2f7;
  color: #98a2b3;
}
