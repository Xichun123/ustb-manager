/* Announcements */
.announcements {
  overflow: hidden;
}

.announcement-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.announcement-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.announcement-badge {
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  padding: 0 8rpx;
}

.announcement-arrow {
  font-size: 20rpx;
  color: #999;
}

.announcement-list {
  margin-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.announcement-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.announcement-item:last-child {
  border-bottom: none;
}

.announcement-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* View Tabs */
.view-tabs {
  display: flex;
  padding: 4rpx;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 14rpx;
}

.view-tab.active {
  background: #1890ff;
  color: #fff;
  font-weight: 600;
}

.filters {
  display: flex;
  gap: 16rpx;
}

.picker-btn {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

/* Stats row */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-chip {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-chip-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1890ff;
}

.stat-chip-label {
  font-size: 24rpx;
  color: #999;
}

/* Course items */
.course-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.course-item:last-child {
  border-bottom: none;
}

.course-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.course-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.course-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.course-info {
  font-size: 24rpx;
  color: #999;
}

.course-capacity {
  font-size: 24rpx;
  color: #666;
}

/* Conflict check button */
.course-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.conflict-btn {
  font-size: 22rpx;
  color: #1890ff;
  padding: 4rpx 16rpx;
  border: 1rpx solid #1890ff;
  border-radius: 8rpx;
}
