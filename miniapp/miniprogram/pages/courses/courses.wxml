<!--courses.wxml-->
<view class="page-container">
  <view class="announcements card" wx:if="{{announcements.length > 0}}">
    <view class="announcement-header" bindtap="toggleAnnouncements">
      <text class="announcement-title">选课公告</text>
      <text class="announcement-badge">{{announcements.length}}</text>
      <text class="announcement-arrow">{{showAnnouncements ? '收起' : '展开'}}</text>
    </view>
    <view class="announcement-list" wx:if="{{showAnnouncements}}">
      <view class="announcement-item" wx:for="{{announcements}}" wx:key="id">
        <text class="announcement-text">{{item.title}}{{item.content ? '：' + item.content : ''}}</text>
      </view>
    </view>
  </view>

  <view class="view-tabs card">
    <view class="view-tab {{viewMode === 'selected' ? 'active' : ''}}" data-mode="selected" bindtap="switchView">已选课程</view>
    <view class="view-tab {{viewMode === 'available' ? 'active' : ''}}" data-mode="available" bindtap="switchView">可选课程</view>
  </view>

  <view class="card filters-card">
    <view class="filter-grid">
      <picker class="picker-item picker-wide" mode="selector" range="{{termList}}" range-key="label" value="{{selectedTermIdx}}" bindchange="onTermChange">
        <view class="picker-btn picker-wide">
          <text class="picker-label">学期</text>
          <text class="picker-value">{{termList[selectedTermIdx] ? termList[selectedTermIdx].label : '选择学期'}}</text>
        </view>
      </picker>

      <picker wx:if="{{viewMode === 'available'}}" class="picker-item" mode="selector" range="{{methods}}" range-key="label" value="{{selectedMethodIdx}}" bindchange="onMethodChange">
        <view class="picker-btn">
          <text class="picker-label">方式</text>
          <text class="picker-value">{{methods[selectedMethodIdx].label}}</text>
        </view>
      </picker>

      <picker wx:if="{{viewMode === 'available'}}" class="picker-item" mode="selector" range="{{colleges}}" range-key="label" value="{{selectedCollegeIdx}}" bindchange="onCollegeChange">
        <view class="picker-btn">
          <text class="picker-label">学院</text>
          <text class="picker-value">{{colleges[selectedCollegeIdx].label}}</text>
        </view>
      </picker>

      <picker wx:if="{{viewMode === 'available'}}" class="picker-item" mode="selector" range="{{categoryOptions}}" range-key="label" value="{{selectedCategoryIdx}}" bindchange="onCategoryChange">
        <view class="picker-btn">
          <text class="picker-label">类别</text>
          <text class="picker-value">{{categoryOptions[selectedCategoryIdx].label}}</text>
        </view>
      </picker>

      <picker wx:if="{{viewMode === 'available'}}" class="picker-item" mode="selector" range="{{campuses}}" range-key="label" value="{{selectedCampusIdx}}" bindchange="onCampusChange">
        <view class="picker-btn">
          <text class="picker-label">校区</text>
          <text class="picker-value">{{campuses[selectedCampusIdx].label}}</text>
        </view>
      </picker>
    </view>

    <view class="search-box">
      <input class="search-input" type="text" placeholder="搜索课程名称 / 代码 / 教师 / 学院" value="{{searchText}}" bindinput="onSearchInput" />
    </view>
  </view>

  <view class="stats-grid" wx:if="{{!loading}}">
    <view class="stat-card">
      <text class="stat-value">{{courseCount}}</text>
      <text class="stat-label">{{viewMode === 'selected' ? '已选课程' : '可选课程'}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{totalCredits}}</text>
      <text class="stat-label">总学分</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{totalHours}}</text>
      <text class="stat-label">总学时</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{collegeCount}}</text>
      <text class="stat-label">开课学院</text>
    </view>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <view class="refresh-indicator" wx:if="{{refreshing}}">
      <view class="refresh-dot"></view>
      <text class="refresh-text">正在同步选课数据</text>
    </view>

    <view class="card" wx:if="{{displayCourses.length > 0}}">
      <view
        class="course-item"
        wx:for="{{displayCourses}}"
        wx:key="course_id"
        data-index="{{index}}"
        bindtap="onCourseClick"
      >
        <view class="course-top">
          <view class="course-title">
            <text class="course-name">{{item.course_name}}</text>
            <text class="course-code">{{item.course_code}}</text>
          </view>
          <text class="tag {{item.course_nature === '必修' ? 'tag-red' : 'tag-blue'}}">{{item.course_nature || '课程'}}</text>
        </view>

        <view class="course-meta-row">
          <text class="course-info">{{item.teacher || '未安排教师'}} · {{item.credits || '--'}}学分 · {{item.hours || '--'}}学时</text>
          <text class="capacity-tag">{{item.selected_count || 0}}/{{item.capacity || 0}}</text>
        </view>

        <view class="course-meta-row secondary" wx:if="{{item.college || item.campus || item.method}}">
          <text class="course-subinfo">{{item.college || '--'}} · {{item.campus || '--'}} · {{item.method || '--'}}</text>
        </view>

        <view class="course-meta-row secondary" wx:if="{{item.schedule_time || item.schedule_location}}">
          <text class="course-subinfo">{{item.schedule_time || '--'}} {{item.schedule_location || ''}}</text>
        </view>

        <view class="course-actions">
          <view class="action-btn action-btn-danger" wx:if="{{viewMode === 'selected'}}" catchtap="onDropCourse" data-index="{{index}}">
            {{droppingCourseId === item.course_id ? '退课中...' : '退课'}}
          </view>

          <block wx:if="{{viewMode === 'available'}}">
            <view class="action-btn action-btn-muted" catchtap="onCheckConflict" data-index="{{index}}">
              {{checkingConflictId === item.course_id ? '检测中...' : '冲突检测'}}
            </view>
            <view
              class="action-btn {{item.is_selected ? 'action-btn-disabled' : 'action-btn-primary'}}"
              catchtap="onSelectCourse"
              data-index="{{index}}"
            >
              {{item.is_selected ? '已选' : (selectingCourseId === item.course_id ? '选课中...' : '选课')}}
            </view>
          </block>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{displayCourses.length === 0}}"
      message="{{viewMode === 'selected' ? '暂无已选课程' : '暂无可选课程'}}"
      iconSrc="/assets/feature/courses.png"
    />
  </block>
</view>
