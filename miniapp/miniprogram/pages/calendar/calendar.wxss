.toolbar { display: flex; justify-content: space-between; align-items: center; }
.month { color: #1890ff; }
.week { margin-top: 20rpx; }
.week-title { font-size: 28rpx; font-weight: 600; }
.dates { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.date { padding: 8rpx 14rpx; background: #f0f5ff; border-radius: 8rpx; font-size: 22rpx; }
