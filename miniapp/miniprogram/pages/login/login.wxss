.login-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 32rpx;
}

.login-header {
  text-align: center;
  padding: 80rpx 0 48rpx;
}

.login-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #1890ff;
}

.login-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
}

/* Tabs */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #1890ff;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

/* Form */
.login-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.code-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.code-input-wrap {
  flex: 1;
}

.send-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  white-space: nowrap;
  border: none;
}

.send-btn::after {
  border: none;
}

.send-btn.disabled {
  background: #d9d9d9;
  color: #999;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1890ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 32rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #d9d9d9;
}

.cookie-tip {
  padding: 16rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #1890ff;
}

/* QR */
.qr-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-container {
  width: 400rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.qr-image {
  width: 400rpx;
  height: 400rpx;
}

.qr-placeholder {
  background: #f5f5f5;
  border-radius: 16rpx;
}

.qr-loading {
  font-size: 28rpx;
  color: #999;
}

.qr-status {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.refresh-btn {
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  background: #fff;
  color: #1890ff;
  border: 1rpx solid #1890ff;
  border-radius: 12rpx;
}

.refresh-btn::after {
  border: none;
}
