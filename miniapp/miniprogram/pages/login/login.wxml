<view class="login-page">
  <view class="login-header">
    <text class="login-title">USTB Manager</text>
    <text class="login-subtitle">北京科技大学教务管理</text>
  </view>

  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab {{activeTab === 'qr' ? 'active' : ''}}" data-tab="qr" bindtap="switchTab">
      <text>扫码登录</text>
    </view>
    <view class="tab {{activeTab === 'sms' ? 'active' : ''}}" data-tab="sms" bindtap="switchTab">
      <text>短信登录</text>
    </view>
    <view class="tab {{activeTab === 'cookie' ? 'active' : ''}}" data-tab="cookie" bindtap="switchTab">
      <text>Cookie登录</text>
    </view>
  </view>

  <!-- QR Login -->
  <view class="login-form qr-form" wx:if="{{activeTab === 'qr'}}">
    <view class="qr-container" wx:if="{{qrImage}}">
      <image class="qr-image" src="{{qrImage}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
    </view>
    <view class="qr-container qr-placeholder" wx:else>
      <text class="qr-loading">{{loading ? '加载中...' : '点击加载二维码'}}</text>
    </view>
    <text class="qr-status">{{qrStatus}}</text>
    <button class="action-btn secondary-action" bindtap="refreshQR" disabled="{{loading}}">
      <image class="action-icon" src="/assets/action/refresh.png" mode="aspectFit" />
      <text class="action-text">{{loading ? '正在加载' : '刷新二维码'}}</text>
    </button>
  </view>

  <!-- SMS Login -->
  <view class="login-form" wx:if="{{activeTab === 'sms'}}">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="form-item code-row">
      <view class="code-input-wrap">
        <text class="form-label">验证码</text>
        <input
          class="form-input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          value="{{code}}"
          bindinput="onCodeInput"
        />
      </view>
      <button
        class="action-btn inline-secondary-action {{countdown > 0 || smsSending ? 'disabled' : ''}}"
        disabled="{{countdown > 0 || smsSending}}"
        bindtap="sendCode"
      >
        <image class="action-icon" src="/assets/action/sms-send.png" mode="aspectFit" />
        <text class="action-text">{{countdown > 0 ? countdown + 's' : '发送验证码'}}</text>
      </button>
    </view>
    <button class="action-btn stacked-secondary-action" loading="{{loading}}" disabled="{{loading}}" bindtap="smsLogin">
      <image class="action-icon" src="/assets/action/login-submit.png" mode="aspectFit" />
      <text class="action-text">登录</text>
    </button>
  </view>

  <!-- Cookie Login -->
  <view class="login-form" wx:if="{{activeTab === 'cookie'}}">
    <view class="form-item">
      <text class="form-label">Cookie 字符串</text>
      <textarea
        class="form-textarea"
        placeholder="请粘贴从浏览器复制的Cookie"
        value="{{cookieStr}}"
        bindinput="onCookieInput"
        auto-height
      />
    </view>
    <view class="cookie-tip">
      <text class="tip-text">从浏览器登录 byyt.ustb.edu.cn 后，复制 Cookie 粘贴到此处</text>
    </view>
    <button class="action-btn stacked-secondary-action" loading="{{loading}}" disabled="{{loading}}" bindtap="doCookieLogin">
      <image class="action-icon" src="/assets/action/cookie-login.png" mode="aspectFit" />
      <text class="action-text">Cookie 登录</text>
    </button>
  </view>

  <view class="wifi-entry">
    <view class="wifi-divider">
      <text>或者</text>
    </view>
    <button class="action-btn secondary-action wifi-action" bindtap="goWifiOnly">
      <image class="action-icon" src="/assets/action/wifi-only.png" mode="aspectFit" />
      <text class="action-text">只使用校园网</text>
    </button>
  </view>
</view>
