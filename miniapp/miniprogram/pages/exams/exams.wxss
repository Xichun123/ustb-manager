.exam-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.exam-item:last-child {
  border-bottom: none;
}

.exam-item.past {
  opacity: 0.5;
}

.exam-item.today {
  background: #fffbe6;
  margin: 0 -32rpx;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
}

.exam-left {
  flex: 1;
  margin-right: 24rpx;
}

.exam-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.exam-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.exam-date {
  font-size: 24rpx;
  color: #666;
}

.exam-time {
  font-size: 24rpx;
  color: #999;
}

.exam-right {
  text-align: right;
}

.exam-location {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  display: block;
}

.exam-campus {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}
