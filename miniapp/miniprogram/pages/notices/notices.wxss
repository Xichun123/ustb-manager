.notice { margin-bottom: 20rpx; }
.notice-title { font-size: 30rpx; font-weight: 600; display: flex; gap: 12rpx; }
.pin { color: #f5222d; font-size: 22rpx; }
.notice-meta { display: block; color: #999; font-size: 22rpx; margin-top: 10rpx; }
.notice-content { display: block; color: #666; font-size: 24rpx; margin-top: 14rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
