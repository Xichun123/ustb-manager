/**app.wxss**/

page {
  --primary-color: #1890ff;
  --success-color: #52c41a;
  --warning-color: #faad14;
  --error-color: #ff4d4f;
  --text-color: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --border-color: #e8e8e8;
  --bg-color: #f5f5f5;
  --card-bg: #ffffff;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 44rpx;
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --border-radius: 16rpx;
  font-size: var(--font-size-base);
  color: var(--text-color);
  background-color: var(--bg-color);
}

.card {
  background: var(--card-bg);
  border-radius: var(--border-radius);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: var(--spacing-md);
}

.page-container {
  padding: var(--spacing-md);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: var(--primary-color);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-hint {
  color: var(--text-hint);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-error {
  color: var(--error-color);
}

.text-bold {
  font-weight: 600;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  box-sizing: border-box;
  padding: var(--spacing-sm);
  text-align: center;
}

.stat-value {
  font-size: var(--font-size-xxl);
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: var(--font-size-sm);
  color: var(--text-hint);
  margin-top: var(--spacing-xs);
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-size-sm);
}

.tag-blue {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-green {
  background: #f6ffed;
  color: #52c41a;
}

.tag-orange {
  background: #fff7e6;
  color: #fa8c16;
}

.tag-red {
  background: #fff2f0;
  color: #ff4d4f;
}

.btn-primary {
  background: var(--primary-color);
  color: #ffffff;
  border: none;
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-base);
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading-text {
  margin-top: var(--spacing-md);
  color: var(--text-hint);
  font-size: var(--font-size-sm);
}

.refresh-indicator {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--spacing-md);
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f8ff;
  border: 1rpx solid rgba(74, 140, 255, 0.18);
}

.refresh-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4a8cff;
  animation: refreshPulse 1.2s ease-in-out infinite;
}

.refresh-text {
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: #4a8cff;
}

@keyframes refreshPulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.82);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: var(--spacing-md) 0;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-label {
  color: var(--text-secondary);
  font-size: var(--font-size-base);
}

.list-item-value {
  color: var(--text-color);
  font-size: var(--font-size-base);
  font-weight: 500;
}

.section {
  margin-bottom: var(--spacing-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
