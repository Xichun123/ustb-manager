.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 112rpx;
  background: #ffffff;
  border-top: 1rpx solid #edf2f7;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.04);
  padding: 8rpx 12rpx env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 10rpx;
  border-radius: 20rpx;
}

.tab-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: transparent;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #98a2b3;
  margin-top: 4rpx;
  line-height: 1.2;
}

.tab-item.active .tab-icon-wrap {
  background: rgba(24, 144, 255, 0.1);
}

.tab-item.active .tab-text {
  color: #1890ff;
  font-weight: 600;
}
