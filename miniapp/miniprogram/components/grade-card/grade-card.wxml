<view class="grade-card">
  <view class="stat-grid">
    <view class="stat-item">
      <text class="stat-value gpa">{{gpa > 0 ? gpa.toFixed(2) : '--'}}</text>
      <text class="stat-label">GPA</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{totalCredits || '--'}}</text>
      <text class="stat-label">总学分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value passed">{{passedCredits || '--'}}</text>
      <text class="stat-label">已修学分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value {{failedCount > 0 ? 'failed' : ''}}">{{failedCount}}</text>
      <text class="stat-label">不及格</text>
    </view>
  </view>
</view>
