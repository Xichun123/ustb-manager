.schedule-grid {
  width: 100%;
  min-width: 840rpx;
  overflow: visible;
}

.schedule-grid.weekend-hidden {
  min-width: 100%;
}

.schedule-grid.weekend-hidden .grid-header-cell,
.schedule-grid.weekend-hidden .grid-cell {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
}

.grid-header {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 2;
  background: #fff;
}

.grid-corner {
  width: 70rpx;
  min-width: 70rpx;
  background: #f8fbff;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
  position: sticky;
  left: 0;
  z-index: 4;
}

.grid-header-cell {
  flex: 0 0 110rpx;
  width: 110rpx;
  text-align: center;
  padding: 12rpx 6rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
  box-sizing: border-box;
}

.grid-header-cell:last-child {
  border-right: none;
}

.header-day {
  font-size: 24rpx;
  font-weight: 600;
  display: block;
}

.header-date {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #999;
  display: block;
}

.grid-row {
  display: flex;
  min-height: 128rpx;
}

.grid-period {
  width: 70rpx;
  min-width: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fbff;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
  position: sticky;
  left: 0;
  z-index: 1;
}

.period-chip {
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4f8ff 0%, #edf4ff 100%);
  border: 1rpx solid #dce8ff;
}

.period-chip-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
  color: #4a8cff;
}

.grid-cell {
  flex: 0 0 110rpx;
  width: 110rpx;
  min-height: 128rpx;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
  padding: 6rpx;
  box-sizing: border-box;
}

.grid-cell:last-child {
  border-right: none;
}

.course-stack {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.course-stack.single {
  gap: 0;
}

.course-block {
  width: 100%;
  border-radius: 10rpx;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.course-block.single {
  flex: 1;
  min-height: 0;
  justify-content: center;
}

.course-block.multi {
  flex: 1;
  min-height: 52rpx;
  justify-content: center;
}

.course-name {
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.course-weeks {
  margin-top: 4rpx;
  font-size: 15rpx;
  line-height: 1.2;
  opacity: 0.86;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.course-location {
  font-size: 16rpx;
  margin-top: 4rpx;
  opacity: 0.8;
  line-height: 1.25;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Compact mode */
.compact .grid-row {
  min-height: 88rpx;
}

.compact .grid-cell {
  min-height: 88rpx;
}

.compact .course-name {
  -webkit-line-clamp: 2;
}

.compact .course-block.multi {
  min-height: 42rpx;
}

.compact .course-location {
  display: none;
}
