.schedule-grid {
  width: 100%;
  overflow-x: auto;
}

.grid-header {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 2;
  background: #fff;
}

.grid-corner {
  width: 80rpx;
  min-width: 80rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
}

.grid-header-cell {
  flex: 1;
  min-width: 90rpx;
  text-align: center;
  padding: 12rpx 4rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
}

.grid-header-cell:last-child {
  border-right: none;
}

.header-day {
  font-size: 22rpx;
  font-weight: 600;
  display: block;
}

.header-date {
  font-size: 18rpx;
  color: #999;
  display: block;
}

.grid-row {
  display: flex;
  min-height: 120rpx;
}

.grid-period {
  width: 80rpx;
  min-width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #666;
  background: #fafafa;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
}

.grid-cell {
  flex: 1;
  min-width: 90rpx;
  min-height: 120rpx;
  border-bottom: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
  padding: 4rpx;
  box-sizing: border-box;
}

.grid-cell:last-child {
  border-right: none;
}

.course-block {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  padding: 6rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.course-name {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.2;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.course-location {
  font-size: 16rpx;
  margin-top: 4rpx;
  opacity: 0.8;
}

/* Compact mode */
.compact .grid-row {
  min-height: 80rpx;
}

.compact .grid-cell {
  min-height: 80rpx;
}

.compact .course-name {
  -webkit-line-clamp: 2;
}
